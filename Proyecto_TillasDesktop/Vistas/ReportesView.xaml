<!-- Define el control de usuario (UserControl) de WPF. x:Class conecta este diseño XAML con su clase lógica C#. -->
    <UserControl x:Class="TillasDesktop.UI.Vistas.ReportesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000" Background="#F0F4F8">

    <!-- Grid principal que organiza la interfaz en filas independientes para estructurar los elementos verticalmente. -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!--  Fila 0: Se ajusta al espacio del título y los controles desplegables de filtrado. Título y Filtros -->
            <RowDefinition Height="Auto"/>
            <!-- Fila 1: Se adapta al tamaño de las tarjetas con métricas principales (KPIs). -->
            <RowDefinition Height="180"/>
            <!-- Fila 2: Altura fija reservada exclusivamente para el gráfico estadístico de LiveCharts. -->
            <RowDefinition Height="*"/>
            <!-- Fila 3: Ocupa todo el espacio restante disponible para la tabla de reportes recientes. -->
        </Grid.RowDefinitions>

        <!-- SECCIÓN 0: TÍTULO Y FILTROS -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <!-- Título principal de la sección de reportes -->
                <TextBlock Text="REPORTES Y ESTADÍSTICAS" FontSize="20" FontWeight="Bold" Foreground="#102A43"/>
                <!-- Panel horizontal que agrupa los campos y selectores de filtrado -->
                <WrapPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <!-- Filtro por Período -->
                    <StackPanel Margin="0,0,15,0">
                        <TextBlock Text="PERÍODO" FontSize="11" FontWeight="Bold" Foreground="#627D98"/>
                        <ComboBox Width="130" Height="30" Margin="0,5,0,0" SelectedIndex="0">
                            <ComboBoxItem Content="Último Trimestre"/>
                            <ComboBoxItem Content="Este Mes"/>
                            <ComboBoxItem Content="Personalizado"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Filtro por Tipo de Reporte -->
                    <StackPanel Margin="0,0,15,0">
                        <TextBlock Text="TIPO DE REPORTE" FontSize="11" FontWeight="Bold" Foreground="#627D98"/>
                        <ComboBox Width="180" Height="30" Margin="0,5,0,0" SelectedIndex="0">
                            <ComboBoxItem Content="Ventas y Resumen Comercial"/>
                            <ComboBoxItem Content="Stock e Inventario"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Campo de texto para Fecha de Inicio -->
                    <StackPanel Margin="0,0,15,0">
                        <TextBlock Text="FECHA INICIO" FontSize="11" FontWeight="Bold" Foreground="#627D98"/>
                        <TextBox Width="100" Height="30" Text="01/04/2026" VerticalContentAlignment="Center" Margin="0,5,0,0" Padding="5"/>
                    </StackPanel>

                    <!-- Campo de texto para Fecha de Fin -->
                    <StackPanel Margin="0,0,15,0">
                        <TextBlock Text="FECHA FIN" FontSize="11" FontWeight="Bold" Foreground="#627D98"/>
                        <TextBox Width="100" Height="30" Text="30/06/2026" VerticalContentAlignment="Center" Margin="0,5,0,0" Padding="5"/>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>

            <!-- Panel derecho para las acciones principales de generación y exportación -->
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                <!-- Botón de acción para procesar y generar el reporte -->
                <Button Content="GENERAR REPORTE" Width="150" Height="38" Background="#102A43" Foreground="White" FontWeight="Bold" Cursor="Hand" Margin="0,0,0,5">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <!-- Enlace visual para exportar a formatos externos -->
                <TextBlock Text="📄 EXPORTAR PDF/EXCEL" FontSize="11" Foreground="#102A43" FontWeight="Bold" Cursor="Hand" HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>


        <!-- SECCIÓN 1: TARJETAS KPI (INDICADORES CLAVE DE RENDIMIENTO) -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <!-- Tarjeta 1: Ingresos Totales con indicador de crecimiento porcentual -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,10,0" BorderBrush="#E4E7EB" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="INGRESOS TOTALES (TRIMESTRE)" FontSize="11" FontWeight="Bold" Foreground="#627D98"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="$320,500" FontSize="22" FontWeight="Bold" Foreground="#102A43"/>
                        <Border Background="#E1F5FE" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="📈 +8.4%" FontSize="11" FontWeight="Bold" Foreground="#0288D1"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Tarjeta 2: Cantidad total de ventas realizadas -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="15" Margin="0,0,10,0" BorderBrush="#E4E7EB" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="VENTAS REALIZADAS" FontSize="11" FontWeight="Bold" Foreground="#627D98"/>
                    <TextBlock Text="1,250" FontSize="22" FontWeight="Bold" Foreground="#102A43" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Tarjeta 3: Producto con mayor volumen de salida -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="15" BorderBrush="#E4E7EB" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="PRODUCTO ESTRELLA" FontSize="11" FontWeight="Bold" Foreground="#627D98"/>
                    <TextBlock Text="Sneaker Modelo X" FontSize="16" FontWeight="Bold" Foreground="#102A43" Margin="0,5,0,2"/>
                    <TextBlock Text="480 pares" FontSize="12" Foreground="#627D98"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- SECCIÓN 2: GRÁFICO ESTADÍSTICO (LIVECHARTS) -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderBrush="#E4E7EB" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="RESUMEN VENTAS TRIMESTRALES" FontSize="12" FontWeight="Bold" Foreground="#102A43"/>
                <!-- Componente de LiveCharts configurado con una serie de líneas para mostrar la evolución temporal -->
                <lvc:CartesianChart Grid.Row="1" Margin="0,5,0,0" DisableAnimations="True">
                    <lvc:CartesianChart.Series>
                        <lvc:LineSeries Title="Ventas" Values="8200, 21300, 44500, 12300, 55500, 32500" Stroke="#102A43" PointGeometrySize="8"/>
                    </lvc:CartesianChart.Series>
                    <lvc:CartesianChart.AxisX>
                        <lvc:Axis Labels="Abr 2026, , May 2026, , Jun 2026"/>
                    </lvc:CartesianChart.AxisX>
                </lvc:CartesianChart>
            </Grid>
        </Border>

        <!-- SECCIÓN 3: TABLA DE HISTORIAL DE REPORTES RECIENTES -->
        <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="15" BorderBrush="#E4E7EB" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="REPORTES GENERADOS RECIENTEMENTE" FontSize="12" FontWeight="Bold" Foreground="#102A43" Margin="0,0,0,10"/>

                <!-- DataGrid para listar el historial de documentos generados previamente -->
                <DataGrid Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" BorderBrush="#E4E7EB" RowHeight="30">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID REPORTE" Binding="{Binding Id}" Width="90"/>
                        <DataGridTextColumn Header="FECHA GENERACIÓN" Binding="{Binding Fecha}" Width="*"/>
                        <DataGridTextColumn Header="TIPO" Binding="{Binding Tipo}" Width="*"/>
                        <DataGridTextColumn Header="PERÍODO" Binding="{Binding Periodo}" Width="*"/>
                        <DataGridTextColumn Header="GENERADO POR" Binding="{Binding GeneradoPor}" Width="*"/>
                        <DataGridTextColumn Header="TAMAÑO" Binding="{Binding Tamano}" Width="80"/>

                        <!-- Columna personalizada con opciones para descargar o visualizar cada reporte -->
                        <DataGridTemplateColumn Header="ACCIONES" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="🔴" Cursor="Hand" Margin="2" ToolTip="PDF"/>
                                        <TextBlock Text="🟢" Cursor="Hand" Margin="2" ToolTip="Excel"/>
                                        <TextBlock Text="👁️" Cursor="Hand" Margin="2" ToolTip="Ver"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>