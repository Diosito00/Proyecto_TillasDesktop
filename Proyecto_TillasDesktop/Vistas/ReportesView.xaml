<!-- Define el control de usuario (UserControl) de WPF. x:Class conecta este diseño XAML con su clase lógica C#. -->
    <UserControl x:Class="TillasDesktop.UI.Vistas.ReportesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000" Background="#F0F4F8">

    <!-- Grid principal que organiza la interfaz en filas independientes para estructurar los elementos verticalmente. -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Fila 0: Panel superior (Título y Filtros) -->
            <RowDefinition Height="Auto"/>
            <!-- Fila 1: Tarjetas de Resumen (KPIs) -->
            <RowDefinition Height="Auto"/>
            <!-- Fila 2: Gráfico y Tabla -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!-- FILA 0: ENCABEZADO Y FILTROS               -->
        <!-- ========================================== -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Título -->
                    <RowDefinition Height="15"/>
                    <!-- Espaciador -->
                    <RowDefinition Height="Auto"/>
                    <!-- Controles -->
                </Grid.RowDefinitions>

                <!-- Título unificado -->
                <TextBlock Grid.Row="0" Text="REPORTES Y ESTADÍSTICAS" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextoPrincipal}"/>

                <!-- Contenedor de Filtros -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <!-- Periodo -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Desde -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Hasta -->
                        <ColumnDefinition Width="*"/>
                        <!-- Espacio flexible que empuja el botón a la derecha -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Botones -->
                    </Grid.ColumnDefinitions>

                    <!-- Filtro: Período -->
                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Text="PERÍODO" Foreground="{StaticResource BrushTextoSecundario}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox Width="150" ItemsSource="{Binding OpcionesPeriodo}" SelectedItem="{Binding PeriodoSeleccionado, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Filtro: Fecha Inicio -->
                    <StackPanel Grid.Column="1" Margin="0,0,20,0">
                        <TextBlock Text="FECHA INICIO" Foreground="{StaticResource BrushTextoSecundario}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <DatePicker SelectedDate="{Binding FechaInicio, UpdateSourceTrigger=PropertyChanged}" Width="150" Height="30" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Filtro: Fecha Fin -->
                    <StackPanel Grid.Column="2" Margin="0,0,20,0">
                        <TextBlock Text="FECHA FIN" Foreground="{StaticResource BrushTextoSecundario}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <DatePicker SelectedDate="{Binding FechaFin, UpdateSourceTrigger=PropertyChanged}" Width="150" Height="30" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Panel de Botones (Alineado a la derecha) -->
                    <StackPanel Grid.Column="5" VerticalAlignment="Bottom">
                        <Button Content="GENERAR REPORTE" Command="{Binding GenerarReporteCommand}" Style="{StaticResource BotonSecundario}"
                            Height="35" Width="150"/>

                        <Button Content="📄 EXPORTAR PDF / EXCEL" Command="{Binding ExportarCommand}"
                            Background="Transparent" Foreground="{StaticResource BrushPrimario}" BorderThickness="0" 
                            Cursor="Hand" FontSize="10" FontWeight="SemiBold" 
                            Margin="0,5,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- FILA 1: TARJETAS DE MÉTRICAS (KPIs)        -->
        <!-- ========================================== -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Tarjeta 1: Ingresos -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="20">
                <StackPanel>
                    <TextBlock Text="INGRESOS TOTALES (TRIMESTRE)" Foreground="{StaticResource BrushTextoSecundario}" FontSize="11" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0" VerticalAlignment="Bottom">
                        <TextBlock Text="$320,500" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushTextoPrincipal}"/>
                        <TextBlock Text="📈 +8.4%" Foreground="{StaticResource BrushVerde}" FontSize="12" FontWeight="Bold" Margin="10,0,0,4" VerticalAlignment="Bottom"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Tarjeta 2: Ventas -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="20">
                <StackPanel>
                    <TextBlock Text="VENTAS REALIZADAS" Foreground="{StaticResource BrushTextoSecundario}" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="1,250" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushTextoPrincipal}" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Tarjeta 3: Producto Estrella -->
            <Border Grid.Column="4" Background="White" CornerRadius="8" Padding="20">
                <StackPanel>
                    <TextBlock Text="PRODUCTO ESTRELLA" Foreground="{StaticResource BrushTextoSecundario}" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="Sneaker Modelo X" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushPrimario}" Margin="0,5,0,0"/>
                    <TextBlock Text="480 pares vendidos" FontSize="12" Foreground="{StaticResource BrushTextoSecundario}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================== -->
        <!-- FILA 2: DATAGRID DE HISTORIAL DE VENTAS    -->
        <!-- ========================================== -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="ÚLTIMAS VENTAS REALIZADAS" FontWeight="Bold" Foreground="{StaticResource BrushTextoPrincipal}" Margin="0,0,0,15"/>
                
                <DataGrid Grid.Row="1" ItemsSource="{Binding HistorialVentas}" Style="{StaticResource DataGridTillas}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="N° TICKET" Binding="{Binding ID}" Width="*"/>
                        <!-- El StringFormat=g formatea la fecha y hora de manera legible -->
                        <DataGridTextColumn Header="FECHA Y HORA" Binding="{Binding Fecha_Hora, StringFormat=g}" Width="2*"/>
                        <DataGridTextColumn Header="CAJERO" Binding="{Binding NombreVendedor}" Width="2*"/>
                        <DataGridTextColumn Header="CLIENTE" Binding="{Binding NombreCliente}" Width="2*"/>
                        <DataGridTextColumn Header="MÉTODO PAGO" Binding="{Binding MetodoPago}" Width="2*"/>
                        <DataGridTextColumn Header="TOTAL" Binding="{Binding Total, StringFormat=C}" Width="*"/>
                        <DataGridTemplateColumn Header="ACCIONES" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="👁️" ToolTip="Ver Detalle de Venta"
                                            Command="{Binding DataContext.VerDetalleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="14"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

    </Grid>
</UserControl>