<!-- Define el control de usuario (UserControl) de WPF. x:Class conecta este diseño XAML con su clase lógica C#. -->
    <UserControl x:Class="TillasDesktop.UI.Vistas.ReportesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000" Background="#F0F4F8">

    <!-- Grid principal que organiza la interfaz en filas independientes para estructurar los elementos verticalmente. -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Fila 0: Panel superior (Título y Filtros) -->
            <RowDefinition Height="Auto"/>
            <!-- Fila 1: Tarjetas de Resumen (KPIs) -->
            <RowDefinition Height="Auto"/>
            <!-- Fila 2: Gráfico y Tabla -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!-- FILA 0: ENCABEZADO Y FILTROS               -->
        <!-- ========================================== -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect Color="#A0B0C0" Direction="270" ShadowDepth="3" BlurRadius="15" Opacity="0.2"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <!-- Nueva fila para filtros secundarios -->
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="REPORTES Y ESTADÍSTICAS" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextoPrincipal}"/>

                <!-- Filtros Principales -->
                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="TIPO DE REPORTE" Foreground="{StaticResource BrushTextoSecundario}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox Width="200" ItemsSource="{Binding OpcionesTipoReporte}" SelectedItem="{Binding TipoReporteSeleccionado, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="PERÍODO" Foreground="{StaticResource BrushTextoSecundario}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox Width="150" ItemsSource="{Binding OpcionesPeriodo}" SelectedItem="{Binding PeriodoSeleccionado, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="DESDE" Foreground="{StaticResource BrushTextoSecundario}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <DatePicker SelectedDate="{Binding FechaInicio, UpdateSourceTrigger=PropertyChanged}" Width="130" Height="30"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="HASTA" Foreground="{StaticResource BrushTextoSecundario}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <DatePicker SelectedDate="{Binding FechaFin, UpdateSourceTrigger=PropertyChanged}" Width="130" Height="30"/>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Bottom">
                        <Button Content="GENERAR REPORTE" Command="{Binding GenerarReportePdfCommand}" Style="{StaticResource BotonSecundario}" Height="35" Width="150"/>
                    </StackPanel>
                </StackPanel>

                <!-- Filtros Secundarios (Se ocultan automáticamente si no se selecciona 'Productos Más Vendidos') -->
                <StackPanel Grid.Row="4" Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TipoReporteSeleccionado}" Value="Productos Más Vendidos">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="FILTRAR MARCA" Foreground="{StaticResource BrushTextoSecundario}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox Width="150" ItemsSource="{Binding OpcionesMarcas}" SelectedItem="{Binding MarcaSeleccionada}"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="FILTRAR CATEGORÍA" Foreground="{StaticResource BrushTextoSecundario}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox Width="150" ItemsSource="{Binding OpcionesCategorias}" SelectedItem="{Binding CategoriaSeleccionada}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- FILA 1: TARJETAS DE MÉTRICAS (KPIs)        -->
        <!-- ========================================== -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Tarjeta 1: Ingresos -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="#A0B0C0" Direction="270" ShadowDepth="3" BlurRadius="15" Opacity="0.2"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{Binding KpiTituloIngresos}" Foreground="{StaticResource BrushTextoSecundario}" FontSize="11" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding KpiIngresos}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushTextoPrincipal}"/>
                        <!-- Ocultamos el crecimiento por ahora hasta tener lógica de comparación contra el mes anterior -->
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Tarjeta 2: Ventas -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="#A0B0C0" Direction="270" ShadowDepth="3" BlurRadius="15" Opacity="0.2"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="VENTAS REALIZADAS" Foreground="{StaticResource BrushTextoSecundario}" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding KpiVentas}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushTextoPrincipal}" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Tarjeta 3: Producto Estrella -->
            <Border Grid.Column="4" Background="White" CornerRadius="8" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="#A0B0C0" Direction="270" ShadowDepth="3" BlurRadius="15" Opacity="0.2"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="PRODUCTO ESTRELLA" Foreground="{StaticResource BrushTextoSecundario}" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding KpiProductoEstrellaNombre}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushPrimario}" Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding KpiProductoEstrellaDetalle}" FontSize="12" Foreground="{StaticResource BrushTextoSecundario}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================== -->
        <!-- FILA 2: GRAFICOS    -->
        <!-- ========================================== -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="20">
            <Border.Effect>
                <DropShadowEffect Color="#A0B0C0" Direction="270" ShadowDepth="3" BlurRadius="15" Opacity="0.2"/>
            </Border.Effect>

            <Grid>
                <TextBlock Text="{Binding TipoReporteSeleccionado}" FontWeight="Bold" Foreground="{StaticResource BrushTextoPrincipal}" Margin="0,0,0,15" VerticalAlignment="Top"/>

                <!-- GRÁFICO 1: REPORTE DE VENTAS (Línea de tiempo) -->
                <!-- Zona segura con Border -->
                <Border x:Name="GraficoVentasControl" Background="White" Margin="0,35,0,0" Padding="20">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TipoReporteSeleccionado}" Value="Reporte de Ventas">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <lvc:CartesianChart Series="{Binding GraficoVentas}" Height="600" FontSize="22">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Title="Días" Labels="{Binding EtiquetasVentas}" />
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="Ingresos" LabelFormatter="{Binding FormatoMoneda}" />
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </Border>

                <!-- GRÁFICO 2: RENDIMIENTO DE VENDEDORES (Barras) -->
                <!-- Zona segura con Border -->
                <Border x:Name="GraficoVendedoresControl" Background="White" Margin="0,35,0,0" Padding="20">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TipoReporteSeleccionado}" Value="Rendimiento de Vendedores">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <lvc:CartesianChart Series="{Binding GraficoVendedores}" Height="600" FontSize="22">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Title="Cajeros / Vendedores" Labels="{Binding EtiquetasVendedores}" />
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="Total Recaudado" LabelFormatter="{Binding FormatoMoneda}" />
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </Border>

                <!-- GRÁFICO 3: PRODUCTOS MÁS VENDIDOS (Torta/Pie) -->
                <!-- Le damos el x:Name al Border y un Padding de 20 para crear una "zona segura" para la captura -->
                <Border x:Name="GraficoProductosControl" Background="White" Margin="0,35,0,0" Padding="20">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TipoReporteSeleccionado}" Value="Productos Más Vendidos">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <lvc:PieChart Series="{Binding GraficoProductos}" LegendLocation="Right" Height="550" FontSize="22"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>