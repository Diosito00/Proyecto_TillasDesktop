<Window x:Class="TillasDesktop.UI.Vistas.IngresoStockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ingreso de Stock" Height="400" Width="400" 
        WindowStartupLocation="CenterScreen" Background="#F0F4F8" ResizeMode="NoResize">

    <Border Background="White" CornerRadius="10" Margin="20" Padding="20">
        <Border.Effect>
            <DropShadowEffect Color="#A0B0C0" Direction="270" ShadowDepth="3" BlurRadius="15" Opacity="0.2"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="{Binding TituloVentana}" FontSize="18" FontWeight="ExtraBold" Foreground="{StaticResource BrushTextoPrincipal}" HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <!-- Etiqueta de solo lectura para saber qué estamos modificando -->
            <TextBlock Text="{Binding ProductoResumen}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushPrimario}" TextWrapping="Wrap" Margin="0,0,0,25"/>

            <TextBlock Text="Talle" FontWeight="SemiBold" Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Talle, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding EsModoEdicion}" Margin="0,0,0,15"/>

            <TextBlock Text="Cantidad a Ingresar" FontWeight="SemiBold" Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,25"/>

            <Button Content="{Binding TextoBoton}" Command="{Binding GuardarCommand}" IsDefault="True" Height="45" Style="{StaticResource BotonPrimario}"/>
        </StackPanel>
    </Border>
</Window>
