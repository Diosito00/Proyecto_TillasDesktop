<Window x:Class="TillasDesktop.UI.Vistas.AutorizacionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autorización Requerida" Height="360" Width="350"
        WindowStartupLocation="CenterScreen" 
        ResizeMode="NoResize" 
        Topmost="True" Background="#F5F6FA">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Background="White" CornerRadius="10" Margin="10" Padding="20">
            <Border.Effect>
                <DropShadowEffect Color="#A0B0C0" Direction="270" ShadowDepth="3" BlurRadius="15" Opacity="0.2"/>
            </Border.Effect>
            <StackPanel>

                <TextBlock Text="🔒 Permisos Especiales" FontSize="18" FontWeight="ExtraBold" Foreground="{StaticResource BrushTextoPrincipal}" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="Ingresa credenciales de Gerente o Admin" FontSize="11" Foreground="{StaticResource BrushTextoSecundario}" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="Usuario:" Foreground="{StaticResource BrushTextoPrincipal}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtUsuario" Margin="0,0,0,15" Padding="5" FontSize="14"/>

                <TextBlock Text="Contraseña:" Foreground="{StaticResource BrushTextoPrincipal}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtPassword" Margin="0,0,0,20" Padding="5" FontSize="14"/>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Content="Autorizar" Style="{StaticResource BotonPrimario}" IsDefault="True" Width="90" Height="35" Click="BtnAutorizar_Click"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>