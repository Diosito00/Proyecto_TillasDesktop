<UserControl x:Class="TillasDesktop.UI.Vistas.InventarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TillasDesktop.UI.Vistas"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#F0F4F8">

    <Grid Margin="20,20,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Cabecera de controles -->
            <RowDefinition Height="*"/> <!-- Grilla de datos -->
        </Grid.RowDefinitions>

        <!-- PANEL SUPERIOR: Buscador y Botones de Acción -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" Margin="0,0,0,15" Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.08" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Título -->
                <TextBlock Text="CATÁLOGO E INVENTARIO" FontSize="18" FontWeight="ExtraBold" Foreground="{StaticResource BrushTextoPrincipal}" VerticalAlignment="Center"/>

                <!-- Buscador -->
                <TextBox Grid.Column="1" Width="350" Height="40" Margin="30,0,0,0" HorizontalAlignment="Left"
                         Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Botones -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="📦 INGRESAR STOCK" Command="{Binding IngresarStockCommand}" Height="40" Width="160" Margin="0,0,15,0" 
                            Style="{StaticResource BotonGris}"/>
                    <Button Content="+ NUEVO MODELO" Command="{Binding NuevoModeloCommand}" Height="40" Width="150" 
                            Style="{StaticResource BotonSecundario}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- PANEL INFERIOR: Tabla Principal (DataGrid) -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.08" Color="Black"/>
            </Border.Effect>
            <DataGrid x:Name="dgInventario" AutoGenerateColumns="False" Background="White" ItemsSource="{Binding ListaProductos}"
                      SelectedItem="{Binding ProductoSeleccionado}" RowBackground="{StaticResource BrushFondo}" AlternatingRowBackground="White" 
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#e2e8f0" BorderThickness="0" FontSize="14">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="CÓDIGO" Width="130" Binding="{Binding Codigo_Modelo}" Foreground="{StaticResource BrushTextoPrincipal}"/>
                    <DataGridTextColumn Header="NOMBRE DEL MODELO" Width="*" Binding="{Binding Nombre}" Foreground="{StaticResource BrushTextoPrincipal}"/>
                    <DataGridTextColumn Header="MARCA" Width="120" Binding="{Binding Marca}" Foreground="{StaticResource BrushTextoPrincipal}"/>
                    <DataGridTextColumn Header="CATEGORÍA" Width="120" Binding="{Binding Categoria}" Foreground="{StaticResource BrushTextoPrincipal}"/>
                    <DataGridTextColumn Header="PRECIO VENTA" Width="130" Binding="{Binding Precio_Venta, StringFormat=C}" Foreground="{StaticResource BrushTextoPrincipal}"/>
                    <DataGridTextColumn Header="STOCK TOTAL" Width="110" Binding="{Binding StockTotal}" Foreground="{StaticResource BrushTextoPrincipal}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
