<UserControl x:Class="TillasDesktop.UI.Vistas.InventarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TillasDesktop.UI.Vistas"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#F0F4F8">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Cabecera de controles -->
            <RowDefinition Height="*"/> <!-- Grilla de datos -->
        </Grid.RowDefinitions>

        <!-- PANEL SUPERIOR: Buscador y Botones de Acción -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Margin="0,0,0,20" Padding="15">
            <Border.Effect>
                <DropShadowEffect Color="#A0B0C0" Direction="270" ShadowDepth="3" BlurRadius="15" Opacity="0.2"/>
            </Border.Effect>

            <DockPanel LastChildFill="False">
                <!-- Título Estandarizado -->
                <TextBlock Text="CATÁLOGO E INVENTARIO" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextoPrincipal}" VerticalAlignment="Center"/>

                <!-- Buscador y Botón alineados a la derecha -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBox Width="350" Height="40" Margin="0,0,10,0" VerticalContentAlignment="Center"
                             Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="+ NUEVO MODELO" Command="{Binding NuevoModeloCommand}" Height="35" Width="150" Style="{StaticResource BotonSecundario}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- PANEL INFERIOR: Tabla Principal (DataGrid) -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15">
            <Border.Effect>
                <DropShadowEffect Color="#A0B0C0" Direction="270" ShadowDepth="3" BlurRadius="15" Opacity="0.2"/>
            </Border.Effect>
            <DataGrid ItemsSource="{Binding VistaFiltroProductos}" SelectedItem="{Binding ProductoSeleccionado}" 
                      Style="{StaticResource DataGridTillas}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="CÓDIGO" Width="130" Binding="{Binding Codigo_Modelo}" Foreground="{StaticResource BrushTextoPrincipal}"/>
                    <DataGridTextColumn Header="NOMBRE DEL MODELO" Width="*" Binding="{Binding Nombre}" Foreground="{StaticResource BrushTextoPrincipal}"/>
                    <DataGridTextColumn Header="MARCA" Width="120" Binding="{Binding NombreMarca}" Foreground="{StaticResource BrushTextoPrincipal}"/>
                    <DataGridTextColumn Header="CATEGORÍA" Width="120" Binding="{Binding NombreCategoria}" Foreground="{StaticResource BrushTextoPrincipal}"/>
                    <DataGridTextColumn Header="PRECIO VENTA" Width="130" Binding="{Binding Precio_Venta, StringFormat=C}" Foreground="{StaticResource BrushTextoPrincipal}"/>
                    <DataGridTextColumn Header="STOCK TOTAL" Width="110" Binding="{Binding StockTotal}" Foreground="{StaticResource BrushTextoPrincipal}"/>
                    <DataGridTemplateColumn Header="ACCIONES" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                    <!-- Botón de Talles/Stock (Icono de caja) -->
                                    <Button Content="📦" ToolTip="Ver y gestionar talles"
                                            Command="{Binding DataContext.VerDetalleStockCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>

                                    <!-- Botón de Modificar (Icono de lápiz) -->
                                    <Button Content="✏️" ToolTip="Modificar modelo"
                                            Command="{Binding DataContext.ModificarModeloCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>

                                    <!-- Botón de Eliminar (Icono de papelera) -->
                                    <Button Content="🗑️" ToolTip="Eliminar modelo"
                                            Command="{Binding DataContext.EliminarModeloCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="{StaticResource BrushRojo}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
