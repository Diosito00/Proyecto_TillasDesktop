<Window x:Class="TillasDesktop.UI.Vistas.DetalleStockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding TituloVentana}" 
        Height="650" Width="600"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F5F6FA">
    <!-- Un gris muy sutil para el fondo -->
    <Border Background="White" CornerRadius="10" Margin="20" Padding="20">
        <Border.Effect>
            <DropShadowEffect Color="#A0B0C0" Direction="270" ShadowDepth="3" BlurRadius="15" Opacity="0.2"/>
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <!-- Fila 0: Título -->
                <RowDefinition Height="Auto"/>
                <!-- Fila 1: Tabla de Talles -->
                <RowDefinition Height="*"/>
                <!-- Fila 2: Botonera -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- === TÍTULO === -->
            <TextBlock Grid.Row="0" 
                       Text="{Binding TituloVentana}" 
                       FontSize="18" 
                       FontWeight="ExtraBold" 
                       Foreground="{StaticResource BrushTextoPrincipal}" 
                       Margin="0,0,0,20"/>

            <!-- === TABLA DE TALLES === -->
            <DataGrid Grid.Row="1" ItemsSource="{Binding ListaTalles}" Style="{StaticResource DataGridTillas}">
                <DataGrid.Columns>
                    <!-- La entidad ProductoTalle tiene las propiedades Talle y Stock_Actual -->
                    <DataGridTextColumn Header="TALLE" Binding="{Binding Talle}" Width="*"/>
                    <DataGridTextColumn Header="STOCK DISPONIBLE" Binding="{Binding Stock_Actual}" Width="*"/>
                    <DataGridTemplateColumn Header="ACCIONES" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <!-- Botón Editar -->
                                    <Button Content="✏️" ToolTip="Editar Talle/Stock"
                                            Command="{Binding DataContext.EditarTalleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand" 
                                            FontSize="14" Margin="0,0,10,0"/>
                                    <!-- Botón Eliminar -->
                                    <Button Content="🗑️" ToolTip="Eliminar Talle"
                                            Command="{Binding DataContext.EliminarTalleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" Background="Transparent" BorderThickness="0"  Foreground="{StaticResource BrushRojo}"
                                            Cursor="Hand" FontSize="14"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- === BOTONERA === -->
            <StackPanel Grid.Row="2">
                <Button Content="+ INGRESAR STOCK" Command="{Binding IngresarNuevoStockCommand}" Width="200" Height="45" 
                        Style="{StaticResource BotonSecundario}" Margin="0,10,0,0"/>    
            </StackPanel>
        </Grid>
    </Border>
</Window>