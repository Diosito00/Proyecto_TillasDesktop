<Window x:Class="TillasDesktop.UI.Vistas.DetalleStockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding TituloVentana}" 
        Height="650" Width="600"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F5F6FA">
    <!-- Un gris muy sutil para el fondo -->
    <Border Background="White" CornerRadius="10" Margin="20" Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.08" Color="Black"/>
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <!-- Fila 0: Título -->
                <RowDefinition Height="Auto"/>
                <!-- Fila 1: Tabla de Talles -->
                <RowDefinition Height="*"/>
                <!-- Fila 2: Botonera -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- === TÍTULO === -->
            <TextBlock Grid.Row="0" 
                       Text="{Binding TituloVentana}" 
                       FontSize="18" 
                       FontWeight="ExtraBold" 
                       Foreground="{StaticResource BrushTextoPrincipal}" 
                       Margin="0,0,0,20"/>

            <!-- === TABLA DE TALLES === -->
            <DataGrid Grid.Row="1" 
                      ItemsSource="{Binding ListaTalles}" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      CanUserAddRows="False"
                      HeadersVisibility="Column" 
                      Background="White" 
                      RowHeight="35"
                      BorderBrush="#E0E0E0"
                      BorderThickness="1">
                <DataGrid.Columns>
                    <!-- La entidad ProductoTalle tiene las propiedades Talle y Stock_Actual -->
                    <DataGridTextColumn Header="TALLE" Binding="{Binding Talle}" Width="*"/>
                    <DataGridTextColumn Header="STOCK DISPONIBLE" Binding="{Binding Stock_Actual}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- === BOTONERA === -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cerrar" 
                        IsCancel="True" 
                        Style="{StaticResource BotonSecundario}"
                        Width="140" Height="45"
                        Margin="0,0,10,0"/>

                <Button Content="+ INGRESAR STOCK" 
                        Command="{Binding IngresarNuevoStockCommand}" 
                        Width="140" Height="45" 
                        Style="{StaticResource BotonPrimario}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>