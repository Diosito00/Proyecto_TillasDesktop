<UserControl x:Class="TillasDesktop.UI.Vistas.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushFondo}">

    <Grid Margin="30" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Style="{StaticResource CardStyle}" Width="500" Padding="30">
            <StackPanel>
                <!-- Icono representativo -->
                <TextBlock Text="💾" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <TextBlock Text="RESPALDO DE BASE DE DATOS" FontSize="18" FontWeight="ExtraBold" Foreground="{StaticResource BrushTextoPrincipal}" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <TextBlock Text="Genera una copia de seguridad completa (dump) de todas las tablas, inventario, ventas y registros del sistema en formato SQL." 
                           FontSize="13" Foreground="{StaticResource BrushTextoSecundario}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,25"/>

                <!-- Estado o ruta del último respaldo -->
                <Border Background="{StaticResource BrushGrisClaro}" CornerRadius="6" Padding="12" Margin="0,0,0,25">
                    <StackPanel>
                        <TextBlock Text="Último respaldo realizado:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextoSecundario}"/>
                        <TextBlock Text="{Binding UltimoBackupInfo}" FontSize="12" Foreground="{StaticResource BrushTextoPrincipal}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Botón de acción principal -->
                <Button Content="GENERAR NUEVA COPIA DE SEGURIDAD" Command="{Binding GenerarBackupCommand}" Style="{StaticResource BotonSecundario}" Height="45"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>