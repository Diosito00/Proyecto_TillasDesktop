<!-- Etiqueta raíz Window que define la ventana principal de la aplicación (MenuInicioView). 
     Establece el título, tamaño predeterminado de alto y ancho, maximiza la ventana al iniciar y elimina el marco nativo de Windows (WindowStyle="None"). -->
<Window x:Class="TillasDesktop.UI.Vistas.MenuInicioView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TillasDesktop.UI.Vistas"
        mc:Ignorable="d"
        Title="Tillas Desktop - Inicio" Height="768" Width="1100"
        WindowState="Maximized"
        WindowStyle="None">

    <!-- Contenedor principal Grid que divide la estructura verticalmente en la barra superior personalizada y el contenido de la aplicación. -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- Fila 0: Asigna un alto fijo de 35 píxeles para la barra de título personalizada. -->
            <RowDefinition Height="35"/>
            <!-- Fila 1: Ocupa todo el resto del espacio vertical disponible de la pantalla (*). -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- === NUEVA BARRA SUPERIOR PERSONALIZADA === -->
        <!-- Panel superior ubicado en la fila 0, con color de fondo secundario y un evento para permitir arrastrar la ventana sin marco. -->
        <Grid Grid.Row="0" Background="{StaticResource BrushSecundario}" MouseLeftButtonDown="BarraSuperior_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Panel lateral izquierdo que agrupa el icono decorativo y el título en texto de la aplicación. -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,0,0,0">
                <TextBlock Text="👟" Foreground="White" Margin="0,0,5,0" FontSize="20"/>
                <TextBlock Text="TILLAS DESKTOP" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Panel lateral derecho que contiene los botones funcionales para minimizar y cerrar la aplicación de forma personalizada. -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <!-- Botón de minimizar vinculado a su evento de clic respectivo. -->
                <Button Content="—" Width="35" Background="Transparent" Foreground="White" BorderThickness="0" 
                    Cursor="Hand" Click="BtnMinimizar_Click"/>
                <!-- Botón de cierre vinculado a su evento de clic respectivo. -->
                <Button Content="✕" Width="35" Background="Transparent" Foreground="White" BorderThickness="0" 
                    Cursor="Hand" Click="BtnCerrar_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BrushSecundario}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="230"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=BtnMenuToggle}" Value="True">
                                <Setter Property="Width" Value="60"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ToggleButton x:Name="BtnMenuToggle" Grid.Row="0" Content="≡" Width="40" Height="40" Background="Transparent" BorderThickness="0" 
                                  Foreground="White" FontSize="24" Cursor="Hand" HorizontalAlignment="Left" Margin="10,10,0,10"/>
                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                        <Button x:Name="btnInicio" Content="🏠  INICIO" Style="{StaticResource MenuButton}" Click="BtnInicio_Click"/>
                        <Button x:Name="btnPuntoVenta" Content="🛒  PUNTO DE VENTA" Style="{StaticResource MenuButton}" Click="BtnPuntoVenta_Click"/>
                        <Button x:Name="btnInventario" Content="📦  INVENTARIO" Style="{StaticResource MenuButton}" Click="BtnInventario_Click"/>
                        <Button x:Name="btnClientes" Content="👥  CLIENTES" Style="{StaticResource MenuButton}" Click="BtnClientes_Click"/>
                        <Button x:Name="btnReportes" Content="📈  REPORTES" Style="{StaticResource MenuButton}" Click="BtnReportes_Click"/>
                        <Button x:Name="btnConfiguracion" Content="👤  USUARIOS Y ROLES" Style="{StaticResource MenuButton}" Click="BtnConfiguracion_Click"/>
                        <Button x:Name="btnBackup" Content="⚙  COPIA DE RESPALDO" Style="{StaticResource MenuButton}" Click="BtnBackup_Click"/>
                    </StackPanel>
                    <Button x:Name="btnCerrarSesion" Grid.Row="1" Content="🚪  CERRAR SESIÓN" Style="{StaticResource MenuButton}" 
                            VerticalAlignment="Bottom" Margin="0,0,0,20" Click="BtnCerrarSesion_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="20">
                <ContentControl x:Name="AreaPrincipal"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
