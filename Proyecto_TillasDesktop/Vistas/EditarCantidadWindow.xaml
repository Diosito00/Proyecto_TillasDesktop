<Window x:Class="TillasDesktop.UI.Vistas.EditarCantidadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TillasDesktop.UI.Vistas"
        mc:Ignorable="d"
        Title="Editar Cantidad" Height="280" Width="320"
        WindowStartupLocation="CenterScreen" 
        ResizeMode="NoResize"
        Topmost="True">
    
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Background="White" CornerRadius="10" Margin="10" Padding="20">
            <Border.Effect>
                <DropShadowEffect Color="#A0B0C0" Direction="270" ShadowDepth="3" BlurRadius="15" Opacity="0.2"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="txtMensaje" Text="Ingresa la nueva cantidad para el producto:" TextWrapping="Wrap" FontSize="14"
                       FontWeight="SemiBold" Margin="0,0,0,15"/>

                <TextBox x:Name="txtCantidad" FontSize="20" Padding="5" TextAlignment="Center" KeyDown="TxtCantidad_KeyDown" PreviewTextInput="SoloNumeros_PreviewTextInput"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                    <Button Content="Cancelar" Style="{StaticResource BotonSecundario}" Width="90" Height="30" Margin="0,0,10,0" Click="BtnCancelar_Click"/>
                    <Button Content="Aceptar" Style="{StaticResource BotonPrimario}" Width="90" Height="30" Click="BtnAceptar_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
