<!-- Define una ventana de WPF (Window). x:Class enlaza este diseño visual con su respectiva clase de lógica en C#. -->
<Window x:Class="TillasDesktop.UI.Vistas.FormularioClienteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Cliente" Height="630" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F0F4F8">

    <!-- Contenedor visual Border que genera una tarjeta blanca con esquinas redondeadas y márgenes decorativos. -->
    <Border Background="White" CornerRadius="10" Margin="20" Padding="20">

        <!-- StackPanel ubicado en la fila 1 que apila verticalmente las etiquetas y los campos de entrada (TextBox). -->
        <StackPanel>

            <!-- Título principal del formulario visualizado en la parte superior. -->
            <TextBlock Text="NUEVO CLIENTE" FontSize="18" FontWeight="ExtraBold" Foreground="{StaticResource BrushTextoPrincipal}" HorizontalAlignment="Center" Margin="0,0,0,15"/>
            <!-- Etiqueta y campo de texto para el Nombre -->
            <TextBlock Text="Nombre:" FontWeight="SemiBold" Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" PreviewTextInput="SoloLetras_PreviewTextInput" Margin="0,0,0,10"/>

            <!-- Etiqueta y campo de texto para el Apellido -->
            <TextBlock Text="Apellido:" FontWeight="SemiBold" Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Apellido, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" PreviewTextInput="SoloLetras_PreviewTextInput" Margin="0,0,0,10"/>

            <!-- Etiqueta y campo de texto para el CUIT -->
            <TextBlock Text="CUIT:" FontWeight="Bold" Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Cuit, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" PreviewTextInput="SoloNumeros_PreviewTextInput" Margin="0,0,0,10"/>

            <!-- Etiqueta y campo de texto para el Teléfono -->
            <TextBlock Text="Teléfono:" FontWeight="Bold" Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" PreviewTextInput="Telefono_PreviewTextInput" Margin="0,0,0,10"/>

            <!-- Etiqueta y campo de texto para el Email -->
            <TextBlock Text="Email:" FontWeight="Bold" Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center"/>

            <!-- Botón de guardado ubicado en la fila 2 que ejecuta el método BtnGuardar_Click al presionarlo. -->
            <Button Grid.Row="2" Content="GUARDAR CLIENTE" Margin="0,40,0,0" Height="40" Style="{StaticResource BotonSecundario}" Command="{Binding GuardarCommand}"/>

        </StackPanel>
    </Border>
</Window>
    
    