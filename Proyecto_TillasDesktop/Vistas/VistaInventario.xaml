<UserControl x:Class="TillasDesktop.UI.Vistas.VistaInventario"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TillasDesktop.UI.Vistas"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#F0F4F8">

    <Grid Margin="20,20,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Cabecera de controles -->
            <RowDefinition Height="*"/>
            <!-- Grilla de datos -->
        </Grid.RowDefinitions>

        <!-- PANEL SUPERIOR: Buscador y Botones de Acción -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" Margin="0,0,0,15" Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.08" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Título -->
                <TextBlock Text="CATÁLOGO E INVENTARIO" FontSize="18" FontWeight="ExtraBold" Foreground="#2d3748" VerticalAlignment="Center"/>

                <!-- Buscador -->
                <TextBox Grid.Column="1" Width="350" Height="40" Margin="30,0,0,0" Padding="10,8" HorizontalAlignment="Left"
                         FontSize="14" Background="#edf2f7" BorderBrush="#cbd5e0" BorderThickness="1" 
                         Text="🔍 Buscar por código SKU, marca o modelo..."/>

                <!-- Botones -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="📦 INGRESAR STOCK" Height="40" Width="160" Margin="0,0,15,0" 
                            Background="#e2e8f0" Foreground="#4a5568" FontWeight="Bold" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="+ NUEVO MODELO" Height="40" Width="150" 
                            Background="#3182ce" Foreground="White" FontWeight="Bold" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- PANEL INFERIOR: Tabla Principal (DataGrid) -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.08" Color="Black"/>
            </Border.Effect>
            <DataGrid x:Name="dgInventario" AutoGenerateColumns="False" Background="White" 
                      RowBackground="#f7fafc" AlternatingRowBackground="White" HeadersVisibility="Column" 
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#e2e8f0" BorderThickness="0" FontSize="14">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="CÓDIGO (SKU)" Width="130" Binding="{Binding Codigo_Modelo}"/>
                    <DataGridTextColumn Header="NOMBRE DEL MODELO" Width="*" Binding="{Binding Nombre}"/>
                    <DataGridTextColumn Header="MARCA" Width="120" Binding="{Binding Marca}"/>
                    <DataGridTextColumn Header="CATEGORÍA" Width="120" Binding="{Binding Categoria}"/>
                    <DataGridTextColumn Header="PRECIO VENTA" Width="130" Binding="{Binding Precio_Venta, StringFormat=C}"/>
                    <!-- Stock_Actual será un sumatorio de la tabla Producto_Talles -->
                    <DataGridTextColumn Header="STOCK TOTAL" Width="110" Binding="{Binding StockTotal}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
