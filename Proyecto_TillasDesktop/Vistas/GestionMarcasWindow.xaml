<Window x:Class="TillasDesktop.UI.Vistas.GestionMarcasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Marcas" Height="550" Width="400"
        WindowStartupLocation="CenterScreen" Background="#F0F4F8" ResizeMode="NoResize">

    <Border Background="White" CornerRadius="10" Margin="20" Padding="20">
        <Border.Effect>
            <DropShadowEffect Color="#A0B0C0" Direction="270" ShadowDepth="3" BlurRadius="15" Opacity="0.2"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="ADMINISTRAR MARCAS" FontSize="18" FontWeight="ExtraBold" Foreground="{StaticResource BrushTextoPrincipal}" HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <!-- Formulario de carga rápida -->
            <StackPanel Grid.Row="1" Margin="0,0,0,15">
                <TextBlock Text="Nombre de la Nueva Marca" FontWeight="SemiBold" Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,0,5"/>
                <TextBox Text="{Binding NombreNuevaMarca, UpdateSourceTrigger=PropertyChanged}" Height="35" Margin="0,0,0,10" VerticalContentAlignment="Center"/>
                <Button Content="GUARDAR MARCA" IsDefault="True" Command="{Binding GuardarMarcaCommand}" Height="40" Style="{StaticResource BotonPrimario}"/>
            </StackPanel>

            <!-- Lista de marcas existentes -->
            <DataGrid Grid.Row="2" ItemsSource="{Binding ListaMarcas}" AutoGenerateColumns="False" CanUserAddRows="False" Style="{StaticResource DataGridTillas}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NOMBRE" Binding="{Binding Nombre}" Width="*"/>
                    <DataGridTemplateColumn Header="ACCIONES" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="🗑️" ToolTip="Eliminar Marca"
                                        Command="{Binding DataContext.EliminarMarcaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="{StaticResource BrushRojo}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</Window>