<UserControl x:Class="TillasDesktop.UI.Vistas.InicioView"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TillasDesktop.UI.Vistas"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#F0F4F8">
    
    <!-- CONTENIDO PRINCIPAL -->
    <Grid Grid.Column="1" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- CABECERA -->
            <RowDefinition Height="Auto"/> <!-- KPIs -->
            <RowDefinition Height="*"/> <!-- GRÁFICO -->
            <RowDefinition Height="Auto"/> <!-- TABLA -->
        </Grid.RowDefinitions>

        <!-- CABECERA -->
        <Grid Grid.Row="0" Margin="10,0,10,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Width="350" HorizontalAlignment="Left" Foreground="{StaticResource BrushTextoSecundario}" 
                 Text="🔍 Buscar productos, ventas..."/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="35" Height="35" CornerRadius="17.5" Background="#cbd5e0" Margin="0,0,10,0">
                    <TextBlock Text="👤" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="Admin" FontWeight="Bold" Foreground="{StaticResource BrushTextoPrincipal}"/>
                    <TextBlock Text="fecha/hora" FontSize="11" Foreground="{StaticResource BrushTextoSecundario}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- TARJETAS KPI -->
        <UniformGrid Grid.Row="1" Columns="3">
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Margin="20,15">
                    <TextBlock Text="VENTAS HOY" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextoSecundario}"/>
                    <TextBlock Text="$$$$" FontSize="32" FontWeight="ExtraBold" Foreground="{StaticResource BrushTextoPrincipal}" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Margin="20,15">
                    <TextBlock Text="NUEVOS PEDIDOS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextoSecundario}"/>
                    <TextBlock Text="38" FontSize="32" FontWeight="ExtraBold" Foreground="{StaticResource BrushTextoPrincipal}" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Margin="20,15">
                    <TextBlock Text="ALERTAS DE STOCK" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextoSecundario}"/>
                    <TextBlock Text="5 Modelos" FontSize="32" FontWeight="ExtraBold" Foreground="{StaticResource BrushRojo}" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- GRAFICO -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="RESUMEN VENTAS SEMANAL" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushTextoPrincipal}" Margin="0,0,0,15"/>

                <Border Grid.Row="1" Background="White" CornerRadius="8" Margin="0,10,0,0">
                    <lvc:CartesianChart Series="{Binding SeriesCollection}" LegendLocation="None" Margin="10">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Labels="{Binding Labels}">
                                <lvc:Axis.Separator>
                                    <lvc:Separator Step="1" />
                                </lvc:Axis.Separator>
                            </lvc:Axis>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis LabelFormatter="{Binding Formatter}" />
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </Border>
            </Grid>
        </Border>

        <!-- TABLA VENTAS -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="20" Margin="10,10,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="ÚLTIMAS VENTAS" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushTextoPrincipal}" Margin="0,0,0,15"/>

                <DataGrid Grid.Row="1" Height="140" AutoGenerateColumns="False" Background="White"
                      RowBackground="#f7fafc" AlternatingRowBackground="White" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#e2e8f0" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID VENTA" Width="100" Binding="{Binding ID}"/>
                        <DataGridTextColumn Header="FECHA" Width="120" Binding="{Binding Fecha}"/>
                        <DataGridTextColumn Header="CLIENTE" Width="220" Binding="{Binding Cliente}"/>
                        <DataGridTextColumn Header="TOTAL" Width="120" Binding="{Binding Total}"/>
                        <DataGridTextColumn Header="VENDEDOR" Width="*" Binding="{Binding Vendedor}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
