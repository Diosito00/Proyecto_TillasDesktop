<Window x:Class="TillasDesktop.UI.Vistas.RecuperarPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recuperar Contraseña" Height="440" Width="450" 
        WindowStartupLocation="CenterScreen" Background="#F0F4F8" ResizeMode="NoResize">

    <Border Background="White" CornerRadius="10" Margin="20" Padding="25">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="🔑" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Text="RECUPERAR CONTRASEÑA" FontSize="18" FontWeight="ExtraBold" Foreground="{StaticResource BrushTextoPrincipal}" HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <TextBlock Text="Ingrese su correo electrónico registrado." 
                       TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,0,25" FontSize="13"/>

            <!-- Email -->
            <TextBlock Text="Correo Electrónico" FontWeight="SemiBold" Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,0,5"/>
            <TextBox x:Name="txtEmailRecuperacion" Height="36" Margin="0,0,0,25" VerticalContentAlignment="Center" FontSize="14"/>

            <!-- Botón Enviar -->
            <Button Content="VERIFICAR CORREO" Click="BtnEnviar_Click" Height="42" Style="{StaticResource BotonSecundario}" Margin="0,0,0,12" FontSize="14"/>

            <!-- Botón Volver -->
            <Button Content="VOLVER" Click="BtnVolver_Click" Height="32" Background="Transparent" BorderBrush="Transparent" Foreground="{StaticResource BrushTextoSecundario}" Cursor="Hand" FontWeight="SemiBold"/>
        </StackPanel>
    </Border>
</Window>