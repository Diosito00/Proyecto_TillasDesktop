<Window x:Class="TillasDesktop.UI.Vistas.DetalleVentaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalle de Venta" Height="500" Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#ECF0F1" ResizeMode="NoResize">

    <Border Background="White" CornerRadius="8" Margin="20" Padding="20">
        <Border.Effect>
            <DropShadowEffect Color="#A0B0C0" Direction="270" ShadowDepth="3" BlurRadius="15" Opacity="0.2"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Cabecera -->
                <RowDefinition Height="Auto"/>
                <!-- Info Venta -->
                <RowDefinition Height="*"/>
                <!-- Tabla de Productos -->
                <RowDefinition Height="Auto"/>
                <!-- Pie y Botón -->
            </Grid.RowDefinitions>

            <!-- Título -->
            <TextBlock Grid.Row="0" Text="{Binding VentaGeneral.ID, StringFormat='DETALLE DE TICKET #{0}'}" 
                       FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextoPrincipal}" Margin="0,0,0,15" HorizontalAlignment="Center"/>

            <!-- Datos Generales -->
            <Border Grid.Row="1" Background="White" CornerRadius="5" Padding="15" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding VentaGeneral.Fecha_Hora, StringFormat='Fecha: {0:g}'}" Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding VentaGeneral.NombreVendedor, StringFormat='Cajero: {0}'}" Foreground="{StaticResource BrushTextoSecundario}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding VentaGeneral.NombreCliente, StringFormat='Cliente: {0}'}" Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding VentaGeneral.MetodoPago, StringFormat='Método de Pago: {0}'}" Foreground="{StaticResource BrushTextoSecundario}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Tabla de Detalles -->
            <DataGrid Grid.Row="2" ItemsSource="{Binding Lineas}" Style="{StaticResource DataGridTillas}" Margin="0,0,0,15">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="CANT" Binding="{Binding Cantidad}" Width="Auto"/>
                    <DataGridTextColumn Header="MODELO" Binding="{Binding NombreProducto}" Width="2*"/>
                    <DataGridTextColumn Header="TALLE" Binding="{Binding Talle}" Width="*"/>
                    <DataGridTextColumn Header="PRECIO UNIT." Binding="{Binding PrecioUnitario, StringFormat=C}" Width="*"/>
                    <DataGridTextColumn Header="SUBTOTAL" Binding="{Binding Subtotal, StringFormat=C}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Pie: Total y Cerrar -->
            <Grid Grid.Row="3">
                <TextBlock Text="{Binding VentaGeneral.Total, StringFormat='TOTAL: {0:C}'}" 
                           FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushPrimario}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </Border>
</Window>