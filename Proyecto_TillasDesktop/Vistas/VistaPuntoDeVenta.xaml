<UserControl x:Class="TillasDesktop.UI.Vistas.VistaPuntoDeVenta"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TillasDesktop.UI.Vistas"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#F0F4F8">

    <Grid Margin="10,10,10,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- PANEL IZQUIERDO: Buscador y Carrito -->
        <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="20" Margin="0,0,10,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.08" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Buscador de Código de Barras -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                    <TextBox x:Name="txtCodigoBarras" Width="383" Height="40" Padding="10,8" FontSize="16"
                             Background="#edf2f7" BorderBrush="#cbd5e0" BorderThickness="1" 
                             Tag="Escanear código o buscar modelo..." VerticalContentAlignment="Center"/>
                    <Button x:Name="btnBuscar" Content="AGREGAR" Width="100" Margin="10,0,0,0" 
                            Background="#3182ce" Foreground="White" FontWeight="Bold" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <!-- Tabla del Carrito -->
                <DataGrid x:Name="dgCarrito" Grid.Row="1" AutoGenerateColumns="False" Background="White" 
                          RowBackground="#f7fafc" AlternatingRowBackground="White" HeadersVisibility="Column" 
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#e2e8f0" BorderThickness="1" BorderBrush="#e2e8f0" FontSize="14">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="CANT" Width="60" Binding="{Binding Cantidad}"/>
                        <DataGridTextColumn Header="MODELO" Width="*" Binding="{Binding NombreProducto}"/>
                        <DataGridTextColumn Header="TALLE" Width="70" Binding="{Binding Talle}"/>
                        <DataGridTextColumn Header="PRECIO" Width="100" Binding="{Binding PrecioUnitario, StringFormat=C}"/>
                        <DataGridTextColumn Header="SUBTOTAL" Width="100" Binding="{Binding Subtotal, StringFormat=C}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- PANEL DERECHO: Resumen y Cobro -->
        <Border Grid.Column="1" Background="White" CornerRadius="10" Margin="10,0,0,0" Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.08" Color="Black"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="RESUMEN DE VENTA" FontSize="16" FontWeight="Bold" Foreground="#4a5568" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <!-- Cliente -->
                <TextBlock Text="Cliente (Opcional)" FontWeight="SemiBold" Foreground="#718096" Margin="0,0,0,5"/>
                <ComboBox x:Name="cmbCliente" Height="38" Margin="0,0,0,20" IsEditable="True" Text="Consumidor Final" FontSize="14"/>

                <!-- Método de Pago -->
                <TextBlock Text="Método de Pago" FontWeight="SemiBold" Foreground="#718096" Margin="0,0,0,5"/>
                <ComboBox x:Name="cmbMetodoPago" Height="38" Margin="0,0,0,30" SelectedIndex="0" FontSize="14">
                    <ComboBoxItem Content="Efectivo"/>
                    <ComboBoxItem Content="Tarjeta de Crédito/Débito"/>
                    <ComboBoxItem Content="Transferencia"/>
                </ComboBox>

                <!-- Total -->
                <Border Background="#ebf8ff" CornerRadius="8" Padding="20" Margin="0,0,0,30">
                    <StackPanel>
                        <TextBlock Text="TOTAL A COBRAR" FontSize="14" FontWeight="Bold" Foreground="#3182ce" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="lblTotal" Text="$0.00" FontSize="42" FontWeight="ExtraBold" Foreground="#2b6cb0" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Botón Cobrar -->
                <Button x:Name="btnCobrar" Content="CONFIRMAR COBRO" Height="60" 
                        Background="#48bb78" Foreground="White" FontSize="18" FontWeight="Bold" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
