<UserControl x:Class="TillasDesktop.UI.Vistas.PuntoVentaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TillasDesktop.UI.Vistas"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#F0F4F8">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Fila 0: Barra de búsqueda superior -->
            <RowDefinition Height="Auto"/>
            <!-- Fila 1: Zona de Tablas (Inventario y Carrito) -->
            <RowDefinition Height="*"/>
            <!-- Fila 2: Resumen de Venta y Cobro (Abajo) -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- === FILA 0: BUSCADOR === -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Margin="0,0,0,20" Padding="15">
            <Border.Effect>
                <DropShadowEffect Color="#A0B0C0" Direction="270" ShadowDepth="3" BlurRadius="15" Opacity="0.2"/>
            </Border.Effect>
            <DockPanel LastChildFill="False">
                <TextBlock Text="PUNTO DE VENTA" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextoPrincipal}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBox Width="350" Height="40" Margin="0,0,10,0" VerticalContentAlignment="Center" 
                             Text="{Binding BusquedaRapida, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="LIMPIAR" Command="{Binding LimpiarBusquedaCommand}" Height="35" Width="150" 
                            Style="{StaticResource BotonSecundario}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- === FILA 1: LAS DOS TABLAS LADO A LADO === -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- 50% de la pantalla para el Catálogo -->
                <ColumnDefinition Width="*"/>
                <!-- Espaciador central -->
                <ColumnDefinition Width="20"/>
                <!-- 50% de la pantalla para el Carrito -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Columna Izquierda: INVENTARIO -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="15">
                <Border.Effect>
                    <DropShadowEffect Color="#A0B0C0" Direction="270" ShadowDepth="3" BlurRadius="15" Opacity="0.2"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="CATÁLOGO DISPONIBLE" FontWeight="Bold" Foreground="{StaticResource BrushTextoPrincipal}" Margin="0,0,0,15"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding VistaFiltroCatalogo}" 
                          Style="{StaticResource DataGridTillas}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="MODELO" Binding="{Binding Nombre}" Width="2*"/>
                            <DataGridTextColumn Header="MARCA" Binding="{Binding NombreMarca}" Width="*"/>
                            <DataGridTextColumn Header="TALLE" Binding="{Binding Talle}" Width="*"/>
                            <DataGridTextColumn Header="STOCK" Binding="{Binding Stock_Actual}" Width="*"/>
                            <DataGridTextColumn Header="PRECIO" Binding="{Binding Precio_Venta, StringFormat=C}" Width="*"/>

                            <DataGridTemplateColumn Header="ACCIONES" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="➕" ToolTip="Agregar al carrito"
                                            Command="{Binding DataContext.AgregarAlCarritoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="{StaticResource BrushVerde}" FontSize="16"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Columna Derecha: CARRITO DE COMPRAS -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="15">
                <Border.Effect>
                    <DropShadowEffect Color="#A0B0C0" Direction="270" ShadowDepth="3" BlurRadius="15" Opacity="0.2"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="CARRITO DE COMPRAS" FontWeight="Bold" Foreground="{StaticResource BrushTextoPrincipal}" Margin="0,0,0,15"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Carrito}" 
                          Style="{StaticResource DataGridTillas}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CANT" Binding="{Binding Cantidad}" Width="Auto"/>
                            <DataGridTextColumn Header="MODELO" Binding="{Binding Nombre}" Width="2*"/>
                            <DataGridTextColumn Header="TALLE" Binding="{Binding Talle}" Width="*"/>
                            <DataGridTextColumn Header="P. UNIT" Binding="{Binding PrecioUnitario, StringFormat=C}" Width="*"/>
                            <DataGridTextColumn Header="SUBTOTAL" Binding="{Binding Subtotal, StringFormat=C}" Width="*"/>

                            <DataGridTemplateColumn Header="ACCIONES" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="❌" ToolTip="Quitar del carrito"
                                            Command="{Binding DataContext.QuitarDelCarritoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="{StaticResource BrushRojo}" FontSize="12"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- === FILA 2: RESUMEN Y COBRO (Parte Inferior) === -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Margin="0,20,0,0" Padding="20">
            <Border.Effect>
                <DropShadowEffect Color="#A0B0C0" Direction="270" ShadowDepth="3" BlurRadius="15" Opacity="0.2"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Fila para Fecha y Vendedor -->
                    <RowDefinition Height="Auto"/>
                    <!-- Espaciador -->
                    <RowDefinition Height="10"/>
                    <!-- Fila para Controles de Cobro -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- === METADATOS (Fecha y Usuario) === -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding FechaActual}" Foreground="{StaticResource BrushTextoSecundario}" FontWeight="SemiBold" Margin="0,0,20,0"/>
                    <TextBlock Text="{Binding VendedorActual}" Foreground="{StaticResource BrushTextoSecundario}" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- === CONTROLES DE COBRO === -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Lado Izquierdo: Selectores enlazados al ViewModel -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="Cliente" Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,0,5"/>
                            <ComboBox Width="200" 
                              ItemsSource="{Binding ClientesTotales}" 
                              SelectedItem="{Binding ClienteSeleccionado, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Método de Pago" Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,0,5"/>
                            <ComboBox Width="200" 
                              ItemsSource="{Binding MetodosPago}"
                              SelectedItem="{Binding MetodoPagoSeleccionado, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Lado Derecho: Total y Botón -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,15,0,0">
                        <TextBlock Text="TOTAL A COBRAR:" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextoPrincipal}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <TextBlock Text="{Binding TotalCobrar, StringFormat=C}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushPrimario}" VerticalAlignment="Center" Margin="0,0,20,0"/>

                        <Button Content="CONFIRMAR COBRO" 
                        Command="{Binding CobrarCommand}" 
                        IsDefault="True"
                        Height="45" Width="180" 
                        FontSize="14" Style="{StaticResource BotonPrimario}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
