<Window x:Class="TillasDesktop.UI.Vistas.DetalleVentaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalle de Venta" 
        Height="650" Width="800"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F5F6FA"
        Icon="pack://application:,,,/Recursos/Tillas.ico">

    <!-- Un gris muy sutil para el fondo y sombra exterior -->
    <Border Background="White" CornerRadius="10" Margin="20" Padding="20">
        <Border.Effect>
            <DropShadowEffect Color="#A0B0C0" Direction="270" ShadowDepth="3" BlurRadius="15" Opacity="0.2"/>
        </Border.Effect>
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <!-- Fila 0: Encabezado con datos del ticket -->
                <RowDefinition Height="Auto"/>
                <!-- Fila 1: Tabla de Productos -->
                <RowDefinition Height="*"/>
                <!-- Fila 2: Total -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- === ENCABEZADO === -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="{Binding StringFormat='TICKET N° {0}', Path=VentaID}" FontSize="18" FontWeight="ExtraBold" Foreground="{StaticResource BrushTextoPrincipal}" Margin="0,0,0,15"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding StringFormat='Fecha: {0}', Path=Fecha}" FontSize="13" Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding StringFormat='Cliente: {0}', Path=Cliente}" FontSize="13" Foreground="{StaticResource BrushTextoSecundario}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding StringFormat='Vendedor: {0}', Path=Vendedor}" FontSize="13" Foreground="{StaticResource BrushTextoSecundario}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- === TABLA DE PRODUCTOS === -->
            <DataGrid Grid.Row="1" ItemsSource="{Binding ProductosVendidos}" Style="{StaticResource DataGridTillas}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="CODIGO" Binding="{Binding CodigoModelo}" Width="*"/>
                    <DataGridTextColumn Header="PRODUCTO" Binding="{Binding NombreProducto}" Width="Auto"/>
                    <DataGridTextColumn Header="MARCA" Binding="{Binding Marca}" Width="Auto"/>
                    <DataGridTextColumn Header="TALLE" Binding="{Binding Talle}" Width="Auto"/>
                    <DataGridTextColumn Header="CANT." Binding="{Binding Cantidad}" Width="Auto"/>
                    <DataGridTextColumn Header="PRECIO" Binding="{Binding PrecioUnitario, StringFormat=C}" Width="Auto"/>
                    <DataGridTextColumn Header="SUBTOTAL" Binding="{Binding Subtotal, StringFormat=C}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- === SECCIÓN TOTAL === -->
            <StackPanel Grid.Row="2" Margin="0,20,0,0" HorizontalAlignment="Right">
                <TextBlock Text="TOTAL FACTURADO" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextoSecundario}" HorizontalAlignment="Right"/>
                <TextBlock Text="{Binding Total, StringFormat=C}" FontSize="28" FontWeight="ExtraBold" Foreground="{StaticResource BrushTextoPrincipal}" HorizontalAlignment="Right" Margin="0,5,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>