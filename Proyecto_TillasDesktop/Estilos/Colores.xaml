<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta de Colores Base -->
    <Color x:Key="ColorPrimarioBase">#3182ce</Color> <!-- Azul Éxito -->
    <Color x:Key="ColorSecundarioBase">#102A43</Color> <!-- Negro Acción -->
    <Color x:Key="ColorRojoBase">#e53e3e</Color> <!-- Rojo Borrar/Error -->
    <Color x:Key="ColorGrisBase">#e2e8f0</Color> <!-- Rojo Borrar/Error -->

    <!-- Pinceles (Brushes) para usar directamente en Background, Foreground, etc. -->
    <SolidColorBrush x:Key="BrushPrimario" Color="{StaticResource ColorPrimarioBase}"/>
    <SolidColorBrush x:Key="BrushSecundario" Color="{StaticResource ColorSecundarioBase}"/>
    <SolidColorBrush x:Key="BrushRojo" Color="{StaticResource ColorRojoBase}"/>

    <!-- Pinceles de Texto y Bordes -->
    <SolidColorBrush x:Key="BrushTextoPrincipal" Color="#2d3748"/>
    <SolidColorBrush x:Key="BrushTextoSecundario" Color="#718096"/>
    <SolidColorBrush x:Key="BrushBorde" Color="#cbd5e0"/>
    <SolidColorBrush x:Key="BrushFondo" Color="#f7fafc"/>
    <SolidColorBrush x:Key="BrushGrisClaro" Color="#e2e8f0"/>
</ResourceDictionary>